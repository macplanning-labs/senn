# syntax=docker/dockerfile:1
# ============================================================
# SENN OSS Web Frontend + nginx
# Multi-stage build: compile frontend with internal channel,
# then serve with nginx
# ============================================================

FROM node:20-alpine AS builder

WORKDIR /build

# Copy frontend source
COPY frontend/ .

# Install dependencies
RUN npm ci

# Build with internal channel (OSS self-host)
# VITE_API_BASE_URL is intentionally empty for same-origin proxy
ENV VITE_APP_CHANNEL=internal
ENV VITE_API_BASE_URL=
RUN npm run build

# Final stage: nginx serving the built frontend
FROM nginx:alpine

# Copy nginx configuration
COPY docker/nginx-oss.conf /etc/nginx/conf.d/default.conf

# Copy built frontend from builder
COPY --from=builder /build/dist /app/frontend/dist

# Create empty media volume mount point
RUN mkdir -p /app/media

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
