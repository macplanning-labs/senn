# ============================================================
# SENN — environment variable template (OSS)
# ============================================================
# Copy to .env and fill locally (`cp .env.example .env`). Do NOT commit real values.
# Required for `docker compose up`: DB_PASSWORD, JWT_SECRET_KEY
# Values below are placeholders only.

# サーバー
PORT=8151
BASE_URL=http://localhost:8151
COOKIE_SECURE=false

# データベース(いずれかの形式。DATABASE_URLが優先されます)
DATABASE_URL=postgres://senn:senn@localhost:5432/senn
DB_HOST=localhost
DB_PORT=5432
DB_USER=senn
DB_PASSWORD=change_me
DB_NAME=senn

# 認証(JWT署名用。本番では十分な長さのランダム値に変更すること)
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# 起動時にDBマイグレーションを自動実行するか
RUST_RUN_MIGRATIONS=true

# メディアアップロード
MEDIA_DIR=./media
MAX_UPLOAD_SIZE=20971520

# メール送信(任意)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# WebAuthn / パスキー
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8151

# 外部API連携(任意)
SENN_API_KEY=
SENN_API_USER=管理者
SENN_AI_API_KEY=
SENN_AI_API_USER=ai_agent
TICKET_API_KEY=

# AI連携(任意、いずれか)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
