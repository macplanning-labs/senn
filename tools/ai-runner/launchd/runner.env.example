# ~/.senn-ai-runner/runner.env — ランナーの設定(権限 600。値を、チャットやチケットに貼らない)
export SENN_URL=https://あなたの SENN の URL
# 管理画面「AI 自動実行」→ ランナーを追加 で表示される(srun_ で始まる値。1 回だけ表示)
export RUNNER_TOKEN=
# 同上(署名用の秘密)
export RUNNER_SIGNING_SECRET=
export ALLOWED_REPOS=owner/repo         # 実行を許可するリポジトリ(カンマ区切り)
# SENN の前に Cloudflare Access を置いているときだけ: /api/v1/ai-agent/* 用のサービストークン(2 つそろえる)
export CF_ACCESS_CLIENT_ID=
export CF_ACCESS_CLIENT_SECRET=
# 次は任意(既定のままでよい)
# export ACTIVE_HOURS=9-21              # 実行してよい時間帯
# export CLAUDE_MODEL=...               # 軽いモデルでトークンを節約
# push を許可するとき(最初は安全モードのままにする)
# export SAFE_MODE=0
# export GITHUB_TOKEN=
