# SENN OSS Self-host Environment Configuration
# Copy this file to .env.oss and fill in with your own values
# Do not commit .env.oss to version control (already in .gitignore)

# Database Configuration
DB_PASSWORD=change_me_to_a_random_password
POSTGRES_DB=qa_tool
POSTGRES_USER=qa_admin

# Session & Security (generate random values)
SESSION_SECRET=change_me_to_a_random_secret_key
DJANGO_SECRET_KEY=change_me_to_another_random_secret_key
