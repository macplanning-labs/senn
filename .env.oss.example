# SENN OSS Self-host Environment Configuration
# Copy this file to .env.oss and fill in with your own values
# Do not commit .env.oss to version control (already in .gitignore)
#
# scripts/oss-up.sh を使うと、このファイルを元に .env.oss を生成し、
# ランダムな値を自動で埋めます。

# Database Configuration
DB_PASSWORD=change_me_to_a_random_password
POSTGRES_DB=senn
POSTGRES_USER=senn

# JWT signing key (required)
# 32文字以上のランダム値が必要です。未設定・既定値のままでは起動しません。
# 生成例: openssl rand -base64 48
JWT_SECRET_KEY=change_me_to_a_long_random_secret
