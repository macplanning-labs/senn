# ============================================================
# SENN — environment variable template (OSS)
# ============================================================
# Copy to .env and fill locally (`cp .env.example .env`). Do NOT commit real values.
# Required for `docker compose up`: DB_PASSWORD, JWT_SECRET_KEY (both left EMPTY on purpose)
#
# Easiest: run the one-line `sed` in README.md ("Start") — it fills both values with random ones.
# Or fill in the two values below yourself, e.g.
#   DB_PASSWORD     openssl rand -hex 24      (letters/digits only: it is embedded in a URL)
#   JWT_SECRET_KEY  openssl rand -base64 48

# サーバー
PORT=8151
BASE_URL=http://localhost:8151
COOKIE_SECURE=false

# データベース(いずれかの形式。DATABASE_URLが優先されます)
DATABASE_URL=postgres://senn:senn@localhost:5432/senn
DB_HOST=localhost
DB_PORT=5432
DB_USER=senn
DB_PASSWORD=
DB_NAME=senn

# 認証(JWT署名鍵。必須・空のままでは起動しません)
# 32文字以上のランダム値が必要です。
# 生成例: openssl rand -base64 48
JWT_SECRET_KEY=

# 起動時にDBマイグレーションを自動実行するか
RUST_RUN_MIGRATIONS=true

# メディアアップロード
MEDIA_DIR=./media
MAX_UPLOAD_SIZE=20971520

# 登録の方式(任意。README「Adding people」/「メンバーを増やす」参照)
# 既定: 最初の1人だけ自由に登録でき、2人目からは招待で入る
# SENN_REGISTRATION_MODE=open           # 誰でも登録できる。閉じたネットワークでだけ使う
# SENN_INTERNAL_EMAIL_DOMAINS=example.com  # このドメインの人は自分で登録できる(メール送信の設定が必須)

# メール送信(任意)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# WebAuthn / パスキー
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8151

# 外部API連携(任意)
SENN_API_KEY=
SENN_API_USER=管理者
SENN_AI_API_KEY=
SENN_AI_API_USER=ai_agent
TICKET_API_KEY=

# AI連携(任意、いずれか)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# Dockerイメージの取得設定(任意)
# 既定では ghcr.io/macplanning-labs からプリビルトイメージを取得します。
# ローカルレジストリまたは別の取得先を使う場合は、以下をコメント解除して指定してください。
# SENN_IMAGE_REGISTRY=ghcr.io/macplanning-labs
# SENN_IMAGE_TAG=latest
